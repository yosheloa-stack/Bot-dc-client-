# ─── Discord ─────────────────────────────────────────────────────────────
# Token do bot (Discord Developer Portal > Bot > Token)
DISCORD_TOKEN=
# Application ID (Discord Developer Portal > General Information)
DISCORD_CLIENT_ID=
# ID do servidor de testes (opcional). Se definido, os comandos são
# registrados apenas nesse servidor (atualização instantânea, ideal para
# desenvolvimento). Deixe vazio para registrar os comandos globalmente.
DISCORD_GUILD_ID=
# ID do cargo do Discord com permissão de administrador do bot
# (também pode ser configurado depois pelo painel web).
ADMIN_ROLE_ID=
# ID de um canal de texto para receber avisos administrativos
# (ex: novas solicitações de retirada). Opcional.
ADMIN_LOG_CHANNEL_ID=

# ─── Painel administrativo (web) ────────────────────────────────────────
WEB_PANEL_ENABLED=true
PORT=3000
# URL pública onde o painel/bot ficará acessível (usada para montar a URL
# de notificação do Mercado Pago). Em produção, use a URL real com HTTPS.
PUBLIC_URL=http://localhost:3000
ADMIN_PANEL_USER=admin
ADMIN_PANEL_PASSWORD=troque-esta-senha
SESSION_SECRET=troque-este-segredo-por-uma-string-aleatoria-longa

# ─── API de Passe Booyah ────────────────────────────────────────────────
# Gere esta chave no Painel de Passe. Nunca commite a chave real.
PASSE_API_KEY=
PASSE_API_BASE_URL=https://fluxggx.squareweb.app

# ─── Pix ─────────────────────────────────────────────────────────────────
# Provedor: "manual" (chave Pix estática, confirmação manual pelo admin),
# "mercadopago" ou "efi" (ambos com cobrança e confirmação 100%
# automáticas via webhook). Também pode ser trocado depois pelo painel
# web, sem reiniciar o bot.
PIX_PROVIDER=manual
PIX_KEY=
PIX_MERCHANT_NAME=CEIFADOR
PIX_MERCHANT_CITY=SAO PAULO
PIX_MIN_DEPOSIT_CENTS=500
PIX_MAX_DEPOSIT_CENTS=500000

# Necessário apenas se PIX_PROVIDER=mercadopago
MP_ACCESS_TOKEN=
# Opcional: valida a assinatura dos webhooks do Mercado Pago
MP_WEBHOOK_SECRET=

# Necessário apenas se PIX_PROVIDER=efi (Efí Bank / antiga Gerencianet).
# Client ID e Secret ficam em Efí > Minhas Aplicações. Além deles, a API
# Pix da Efí exige mTLS: baixe o certificado .p12 no painel da Efí e
# aponte EFI_CERT_PATH para o arquivo no servidor onde o bot roda. NUNCA
# commite o arquivo .p12 nem essas credenciais no git.
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=
EFI_CERT_PASSPHRASE=
# true = ambiente de homologação (pix-h.api.efipay.com.br)
EFI_SANDBOX=false

# ─── Banco de dados ──────────────────────────────────────────────────────
# Diretório onde o arquivo SQLite será criado (padrão: ./data)
DATA_DIR=
